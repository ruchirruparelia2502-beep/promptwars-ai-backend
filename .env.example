# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=["*"]

# Gemini / Google AI Studio API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Model Selection (e.g., gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro)
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
